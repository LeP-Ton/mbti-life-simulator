{
  "name": "mbti-life-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node --import tsx scripts/build-standalone.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/simulation/*.test.ts src/social/*.test.ts",
    "experiment": "node --import tsx scripts/experiment.ts"
  },
  "dependencies": {
    "@stdlib/math-base-special-cos": "0.3.1",
    "@stdlib/math-base-special-exp": "0.2.5",
    "@stdlib/math-base-special-ln": "0.2.5",
    "@stdlib/math-base-special-pow": "0.3.1",
    "@stdlib/math-base-special-sqrt": "0.2.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
